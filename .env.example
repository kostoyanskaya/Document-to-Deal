# Copy to .env and adjust. All values below are safe defaults for local/demo use.

ENVIRONMENT=development

# --- Storage ---------------------------------------------------------------
REDIS_URL=redis://redis:6379/0
UPLOAD_DIR=/data/uploads

# --- Uploads -----------------------------------------------------------------
MAX_FILE_SIZE_MB=10

# --- Idempotency -----------------------------------------------------------
IDEMPOTENCY_TTL_SECONDS=86400

# --- Chunking (map-reduce extraction for large documents) ------------------
CHUNK_CHAR_THRESHOLD=6000
CHUNK_SIZE_CHARS=4000
CHUNK_OVERLAP_CHARS=200

# --- LLM ---------------------------------------------------------------------
# mock     -> no API key needed, deterministic rule-based output (default, safe for CI/demo)
# openai   -> requires OPENAI_API_KEY
# deepseek -> requires DEEPSEEK_API_KEY
LLM_PROVIDER=mock

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

LLM_MAX_RETRIES=2
LLM_TIMEOUT_SECONDS=60

# --- Celery ------------------------------------------------------------------
# Set to true only for tests: makes .delay() run synchronously, no worker needed.
CELERY_TASK_ALWAYS_EAGER=false

# --- Logging -------------------------------------------------------------------
LOG_LEVEL=INFO
